{
  "//": "Emit. Depends on db and calc, so `tsc --build` compiles those first.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "paths": {}
  },
  "references": [
    { "path": "../../packages/calc/tsconfig.build.json" },
    { "path": "../../packages/db/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
