# Normalize to LF in the repository; check out native on Windows.
* text=auto

# Scripts keep the line endings their interpreter expects — the app ships
# to both Docker/Linux and Windows Server (REQUIREMENTS §2).
*.sh   text eol=lf
*.bash text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Never munge these. The workbook is the parity source of truth; a stray
# line-ending conversion would corrupt it silently.
*.xls  binary
*.xlsx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
